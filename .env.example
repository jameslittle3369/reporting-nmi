# NMI Transaction Report — Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── SQL Server — merchant list and gateway logins (usr_processors) ────────────
DB_SERVER=JAMESDESKTOP\JDESKTOPSQL
DB_DATABASE=TELCAN
DB_DRIVER={ODBC Driver 17 for SQL Server}

# true = Windows Authentication (the account the script runs as).
# false = SQL Server Authentication using DB_USERNAME / DB_PASSWORD.
DB_TRUSTED_CONNECTION=true
DB_USERNAME=
DB_PASSWORD=

# ─── NMI Query API ─────────────────────────────────────────────────────────────
NMI_QUERY_URL=https://secure.networkmerchants.com/api/query.php

# Optional agentid:url pairs for merchants on a private-label gateway host.
# NMI_URL_OVERRIDES=666:https://alliedwallet.transactiongateway.com/api/query.php
NMI_URL_OVERRIDES=

# ─── AWS SES — email sending ───────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave both blank to use the default credential chain (~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be a verified SES sender address/domain
FROM_ADDRESS=reports@yourdomain.com
FROM_NAME=James Little

# Comma-separated recipients — verified too if your SES account is in sandbox mode
TO_ADDRESSES=you@yourdomain.com,other@example.com

# ─── Report settings ────────────────────────────────────────────────────────────
# Number of days to report (overridable per-run with --days). 1 = yesterday.
REPORT_DAYS=1

# Timezone for report dates and day boundaries (IANA name)
TIMEZONE=America/New_York

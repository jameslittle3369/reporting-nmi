# NMI Transaction Report — Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── SQL Server — merchant list and gateway logins (usr_processors) ────────────
DB_SERVER=JAMESDESKTOP\JDESKTOPSQL
DB_DATABASE=TELCAN
DB_DRIVER={ODBC Driver 17 for SQL Server}

# true = Windows Authentication (the account the script runs as).
# false = SQL Server Authentication using DB_USERNAME / DB_PASSWORD.
DB_TRUSTED_CONNECTION=true
DB_USERNAME=
DB_PASSWORD=

# ─── NMI Query API ─────────────────────────────────────────────────────────────
NMI_QUERY_URL=https://secure.networkmerchants.com/api/query.php

# Optional agentid:url pairs for merchants on a private-label gateway host.
# NMI_URL_OVERRIDES=666:https://alliedwallet.transactiongateway.com/api/query.php
NMI_URL_OVERRIDES=

# ─── Stripe (usr_processors rows with cc_gateway='S') ──────────────────────────
# Restricted API key (rk_live_...) with READ access to: Balance transactions,
# Charges, Disputes and Payouts. Blank = the Stripe row shows as Unavailable.
STRIPE_API_KEY=

# ─── AWS SES — email sending ───────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave both blank to use the default credential chain (~/.aws/credentials or IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must be a verified SES sender address/domain
FROM_ADDRESS=reports@yourdomain.com
FROM_NAME=James Little

# Comma-separated recipients — verified too if your SES account is in sandbox mode
TO_ADDRESSES=you@yourdomain.com,other@example.com

# Comma-separated recipients of the separate "Missing from System" email, sent
# only when a gateway transaction has no matching record in the system. It holds
# the transaction and customer details (name, address, email, phone, last 4).
# Blank = that email is saved locally as IMT_NMI_YYYYMMDD_missing.html instead.
MISSING_TO_ADDRESSES=

# ─── Report settings ────────────────────────────────────────────────────────────
# Number of days to report (overridable per-run with --days). 1 = yesterday.
REPORT_DAYS=1

# Timezone for report dates and day boundaries (IANA name)
TIMEZONE=America/New_York

# Summary bullets file, relative to the script folder (see README "Summary bullets")
SUMMARY_FILE=summary_bullets.txt

# ─── SlimCD (usr_processors rows with cc_gateway='D') ─────────────────────────
# cc_gateway_username:ClientID pairs for rows whose login isn't the numeric
# ClientID the reports API needs. Reconciliation treats each pair as one login.
SLIMCD_CLIENT_IDS=GT-Calls.com:29117

# ─── Reconciliation against the system (see README "Reconciliation") ──────────
# Leave a table blank to skip it. Columns default to requestid,
# cc_gateway_username and CreatedDate (auths) / PaymentDate (payments).
# A name containing double quotes must be wrapped in single quotes: '"PaymentDate"'
RECON_AUTHS_TABLE=
RECON_AUTHS_ID_COLUMN=requestid
RECON_AUTHS_LOGIN_COLUMN=cc_gateway_username
RECON_AUTHS_DATE_COLUMN=CreatedDate
RECON_PAYMENTS_TABLE=
RECON_PAYMENTS_ID_COLUMN=requestid
RECON_PAYMENTS_LOGIN_COLUMN=cc_gateway_username
RECON_PAYMENTS_DATE_COLUMN=PaymentDate
